# Optional defaults for generation. Indexing and offline tests need no key.
# Copy this file to .env and replace the placeholder; never commit .env.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=

# Local single-user catalog + original files + immutable FAISS index versions.
# Relative paths resolve against the project root, not the current shell directory.
COPILOT_DATA_DIR=data/copilot_v2
